<?xml version="1.0"?>
<package format="3">
  <name>fixed_base_workspace_analysis</name>
  <version>0.1.0</version>
  <description>Planning-only fixed-base manipulation workspace characterization.</description>
  <maintainer email="openarm@example.com">openarm</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning</depend>
  <depend>tf2</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>humanoid_sim_description</exec_depend>
  <exec_depend>humanoid_sim_moveit_config</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
