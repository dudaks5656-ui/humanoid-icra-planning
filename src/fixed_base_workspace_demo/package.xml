<?xml version="1.0"?>
<package format="3">
  <name>fixed_base_workspace_demo</name>
  <version>0.1.0</version>
  <description>CSV-driven, visualization-only RViz presentation demo for fixed-base workspace ablation.</description>
  <maintainer email="openarm@example.com">openarm</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>moveit_core</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_ros_planning</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-tk</exec_depend>
  <exec_depend>humanoid_sim_description</exec_depend>
  <exec_depend>humanoid_sim_moveit_config</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
