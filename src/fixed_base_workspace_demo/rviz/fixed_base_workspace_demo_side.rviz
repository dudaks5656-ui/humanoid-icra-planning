Panels: []
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.24
      Cell Size: 0.1
      Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Fixed-base ground grid
      Plane: XY
      Reference Frame: world
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Name: Fixed-base humanoid
      Update Interval: 0
      Visual Enabled: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /fixed_base_workspace_demo/markers
      Name: Workspace clouds and presentation text
  Enabled: true
  Global Options:
    Background Color: 18; 22; 30
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.30
      Field of View: 0.72
      Focal Point:
        X: 0.42
        Y: 0.16
        Z: 1.05
      Invert Z Axis: false
      Name: Side XZ boundary view
      Near Clip Distance: 0.01
      Pitch: 0.08
      Target Frame: world
      Yaw: 3.14159
Window Geometry:
  Height: 1080
  Width: 1920
  X: 0
  Y: 0
