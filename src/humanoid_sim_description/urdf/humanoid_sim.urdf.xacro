<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="humanoid_sim_provisional_v10">
  <!-- Simulation-only model: no hardware, fake hardware, controllers, or ros2_control. -->
  <xacro:include filename="$(find humanoid_sim_description)/urdf/amr_base.xacro"/>
  <xacro:include filename="$(find humanoid_sim_description)/urdf/lift.xacro"/>
  <xacro:include filename="$(find humanoid_sim_description)/urdf/waist.xacro"/>
  <xacro:include filename="$(find humanoid_sim_description)/urdf/openarm_arms_adapter.xacro"/>

  <xacro:property
    name="cad"
    value="${xacro.load_yaml('$(find humanoid_sim_description)/config/cad_frame_transforms.yaml')}"/>
  <xacro:property
    name="provisional_dynamics"
    value="${xacro.load_yaml('$(find humanoid_sim_description)/config/provisional_dynamics.yaml')}"/>

  <!-- ROS convention: +X forward, +Y left, +Z up; metres and radians. -->
  <xacro:humanoid_sim_amr_base/>
  <xacro:humanoid_sim_lift cad="${cad}" dynamics="${provisional_dynamics}"/>
  <xacro:humanoid_sim_waist cad="${cad}" dynamics="${provisional_dynamics}"/>
  <xacro:humanoid_sim_openarm_arms cad="${cad}"/>
</robot>
