<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Intentionally excludes openarm_robot, openarm_body, and every ros2_control Xacro. -->
  <xacro:include filename="$(find openarm_description)/assets/robot/openarm_v1.0/urdf/arm/openarm_arm.xacro"/>
  <xacro:include filename="$(find openarm_description)/assets/robot/openarm_v1.0/urdf/ee/openarm_ee_macro.xacro"/>
  <xacro:include filename="$(find openarm_description)/assets/robot/openarm_v1.0/urdf/ee/ee_dispatcher.xacro"/>

  <xacro:macro name="humanoid_sim_openarm_arms" params="cad">
    <xacro:property name="arm_config_root" value="$(find openarm_description)/assets/robot/openarm_v1.0/config/arm"/>
    <xacro:property name="ee_config_root" value="$(find openarm_description)/assets/end_effector/parallel_link/config"/>
    <xacro:property
      name="validated_mount_alignment"
      value="${xacro.load_yaml('$(find humanoid_sim_description)/config/validated_arm_mount_alignment.yaml')}"/>

    <xacro:property name="arm_joint_limits" value="${xacro.load_yaml(arm_config_root + '/joint_limits.yaml')}"/>
    <xacro:property name="arm_inertials" value="${xacro.load_yaml(arm_config_root + '/inertials.yaml')}"/>
    <xacro:property name="arm_kinematics" value="${xacro.load_yaml(arm_config_root + '/kinematics.yaml')}"/>
    <xacro:property name="arm_kinematics_link" value="${xacro.load_yaml(arm_config_root + '/kinematics_link.yaml')}"/>
    <xacro:property name="arm_kinematics_offset" value="${xacro.load_yaml(arm_config_root + '/kinematics_offset.yaml')}"/>

    <xacro:property name="ee_inertials" value="${xacro.load_yaml(ee_config_root + '/inertials.yaml')}"/>
    <xacro:property name="ee_kinematics" value="${xacro.load_yaml(ee_config_root + '/kinematics.yaml')}"/>
    <xacro:property name="ee_kinematics_link" value="${xacro.load_yaml(ee_config_root + '/kinematics_link.yaml')}"/>
    <xacro:property name="ee_joint_limits" value="${xacro.load_yaml(ee_config_root + '/joint_limits.yaml')}"/>

    <link name="left_arm_mount_link"/>
    <joint name="waist_pitch_to_left_arm_mount_joint" type="fixed">
      <parent link="waist_pitch_link"/>
      <child link="left_arm_mount_link"/>
      <!-- User-defined physical shoulder alignment, visually verified against the assembled platform. -->
      <origin
        xyz="${validated_mount_alignment['validated_left_mount_xyz'][0]} ${validated_mount_alignment['validated_left_mount_xyz'][1]} ${validated_mount_alignment['validated_left_mount_xyz'][2]}"
        rpy="${cad['joint_origins_m']['pitch_to_left_arm_mount']['rpy'][0]} ${cad['joint_origins_m']['pitch_to_left_arm_mount']['rpy'][1]} ${cad['joint_origins_m']['pitch_to_left_arm_mount']['rpy'][2]}"/>
    </joint>

    <link name="right_arm_mount_link"/>
    <joint name="waist_pitch_to_right_arm_mount_joint" type="fixed">
      <parent link="waist_pitch_link"/>
      <child link="right_arm_mount_link"/>
      <!-- User-defined physical shoulder alignment, visually verified against the assembled platform. -->
      <origin
        xyz="${validated_mount_alignment['validated_right_mount_xyz'][0]} ${validated_mount_alignment['validated_right_mount_xyz'][1]} ${validated_mount_alignment['validated_right_mount_xyz'][2]}"
        rpy="${cad['joint_origins_m']['pitch_to_right_arm_mount']['rpy'][0]} ${cad['joint_origins_m']['pitch_to_right_arm_mount']['rpy'][1]} ${cad['joint_origins_m']['pitch_to_right_arm_mount']['rpy'][2]}"/>
    </joint>

    <!-- connected_to is empty so the lower-level macro creates no body or implicit mount joint. -->
    <xacro:openarm_arm
      arm_type="v10" arm_prefix="left_" no_prefix="false"
      description_pkg="openarm_description" connected_to=""
      joint_limits="${arm_joint_limits}" inertials="${arm_inertials}"
      kinematics="${arm_kinematics}" kinematics_link="${arm_kinematics_link}"
      kinematics_offset="${arm_kinematics_offset}"/>

    <xacro:openarm_arm
      arm_type="v10" arm_prefix="right_" no_prefix="false"
      description_pkg="openarm_description" connected_to=""
      joint_limits="${arm_joint_limits}" inertials="${arm_inertials}"
      kinematics="${arm_kinematics}" kinematics_link="${arm_kinematics_link}"
      kinematics_offset="${arm_kinematics_offset}"/>

    <joint name="left_arm_mount_to_openarm_joint" type="fixed">
      <parent link="left_arm_mount_link"/>
      <child link="openarm_left_link0"/>
      <!-- Align the CAD mount frame with the established OpenArm v1.0 left link0 frame. -->
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
    </joint>
    <joint name="right_arm_mount_to_openarm_joint" type="fixed">
      <parent link="right_arm_mount_link"/>
      <child link="openarm_right_link0"/>
      <!-- Align the CAD mount frame with the established OpenArm v1.0 right link0 frame. -->
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </joint>

    <xacro:openarm_ee
      ee_type="parallel_link" connected_to="openarm_left_link7"
      arm_type="v10" arm_prefix="left_"
      ee_kinematics="${ee_kinematics}" ee_kinematics_link="${ee_kinematics_link}"
      ee_inertials="${ee_inertials}" ee_joints_limits="${ee_joint_limits}"
      description_pkg="openarm_description"/>

    <xacro:openarm_ee
      ee_type="parallel_link" connected_to="openarm_right_link7"
      arm_type="v10" arm_prefix="right_"
      ee_kinematics="${ee_kinematics}" ee_kinematics_link="${ee_kinematics_link}"
      ee_inertials="${ee_inertials}" ee_joints_limits="${ee_joint_limits}"
      description_pkg="openarm_description"/>
  </xacro:macro>
</robot>
