Panels:
  - Class: rviz_common/Displays
Visualization Manager:
  Global Options: {Fixed Frame: base_link, Background Color: 28; 32; 38}
  Displays:
    - {Class: rviz_default_plugins/RobotModel, Name: Robot, Description Topic: /robot_description}
    - {Class: rviz_default_plugins/MarkerArray, Name: Workspace, Topic: /lift_slice_fk_workspace/markers}
  Views:
    Current: {Class: rviz_default_plugins/Orbit, Distance: 3.0, Pitch: 0.0, Yaw: 1.5708, Focal Point: {X: 0.2, Y: 0.0, Z: 1.05}}
Window Geometry: {Width: 1600, Height: 900}
